{
  "name": "mini-inventario-web",
  "version": "1.0.0",
  "description": "Mini Inventario Web para Dazi Solar",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "node --watch server/server.js",
    "test": "jest --runInBand",
    "test:unit": "jest tests/unit --runInBand",
    "test:integration": "jest tests/integration --runInBand",
    "test:functional": "npx playwright test tests/functional --reporter=list",
    "test:acceptance": "npx playwright test tests/acceptance --reporter=list",
    "test:performance": "node tests/performance/autocannon.js",
    "test:smoke": "jest tests/smoke --runInBand"
  },
  "keywords": [
    "inventario",
    "solar",
    "sqlite",
    "express"
  ],
  "author": "Copilot",
  "license": "MIT",
  "dependencies": {
    "@playwright/test": "^1.65.0",
    "autocannon": "^9.0.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "jest": "^30.5.2",
    "multer": "^2.5.0",
    "sqlite3": "^6.0.1",
    "supertest": "^7.3.2"
  }
}

